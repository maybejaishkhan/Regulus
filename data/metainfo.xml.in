<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.regulus.Regulus</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Regulus</name>
  <summary>Run Windows apps on Linux with Docker</summary>
  <description>
    <p>
      Regulus is a native GNOME app for running real Windows applications on
      Linux without a full VM window. The Windows virtual machine lives in a
      Docker container (via dockur/windows) and individual apps are streamed
      to the Wayland desktop with FreeRDP RemoteApp.
    </p>
    <p>
      It sets up prerequisites, creates and manages the VM, and lets you
      launch Windows programs as ordinary-looking windows on your Linux
      desktop.
    </p>
  </description>

  <developer id="io.github.maybejaishkhan">
    <name>Jaish Khan</name>
  </developer>

  <url type="homepage">https://github.com/maybejaishkhan/Regulus</url>
  <url type="vcs-browser">https://github.com/maybejaishkhan/Regulus</url>
  <url type="bugtracker">https://github.com/maybejaishkhan/Regulus/issues</url>

  <launchable type="desktop-id">org.regulus.Regulus.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#99c1f1</color>
  </branding>

  <releases>
    <release version="1.0.0" date="2026-09-23">
      <description translate="no">
        <p>First real release: onboarding wizard with distro-aware prerequisite
        fixes, VM sidebar with automatic adoption of existing dockur/windows
        containers, live metrics, guest app discovery, FreeRDP RemoteApp
        streaming, and native distro packages (.deb, RPM, Arch).</p>
      </description>
    </release>
    <release version="0.0.1" date="2026-09-21">
      <description translate="no">
        <p>Initial scaffold: Adw.NavigationView shell, Meson build, Flatpak manifest.</p>
      </description>
    </release>
  </releases>

</component>