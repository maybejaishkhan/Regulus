pkgname=regulus
# pkgver is stamped into this staged copy by .github/scripts/build-arch.sh
# (from the CI tag / workflow_dispatch input / meson.build).
pkgver=sTAMPED_bY_cI # placeholder — build script replaces this line
pkgrel=1
pkgdesc='Run Windows apps on your Linux desktop (dockur/windows VMs + FreeRDP RemoteApp)'
arch=('x86_64')
url='https://github.com/maybejaishkhan/Regulus'
license=('GPL-3.0-or-later')
depends=('gjs' 'gtk4' 'libadwaita' 'gsettings-desktop-schemas')
optdepends=('docker: run Windows VMs' 'freerdp: SDL client sdl-freerdp3 for streaming desktops and apps')
makedepends=('meson' 'ninja' 'appstream' 'desktop-file-utils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver" build
  ninja -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C build
}