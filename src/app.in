#!@GJS@ -m

import { exit, programArgs, programInvocationName } from "system";
import Gio from "gi://Gio";
import GLib from "gi://GLib";

imports.package.init({
  name: "@PACKAGE_NAME@",
  version: "@PACKAGE_VERSION@",
  prefix: "@prefix@",
  libdir: "@libdir@",
  datadir: "@datadir@",
});

if (!GLib.getenv("MESON_BUILD_ROOT")) {
  const here = Gio.File.new_for_uri(import.meta.url);
  const buildSrcDir = here.get_parent().get_path();
  const buildDataDir = GLib.build_filenamev([buildSrcDir, "..", "data"]);
  const bundles = [
    [buildSrcDir, "@APP_ID@.src.gresource"],
    [buildDataDir, "@APP_ID@.data.gresource"],
  ];
  for (const [dir, name] of bundles) {
    const path = GLib.build_filenamev([dir, name]);
    if (GLib.file_test(path, GLib.FileTest.EXISTS))
      Gio.Resource.load(path)._register();
  }
}

const { main } = await import("resource://@resource_path@/js/main.js");
const exit_code = await main([programInvocationName, ...programArgs]);
exit(exit_code);